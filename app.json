{
  "expo": {
    "name": "Beeland Plus",
    "slug": "beeland-app-KH",
    "version": "1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beelandappkh",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beesky.beelandhome",
      "infoPlist": {
        "CFBundleName": "Beeland Plus",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.beesky.beelandhome"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Beeland Plus – Khách hàng",
      "shortName": "Beeland Plus",
      "description": "Tra cứu hợp đồng, lịch thanh toán và phiếu thu bất động sản.",
      "themeColor": "#0A74B8",
      "backgroundColor": "#F3F8FC",
      "lang": "vi"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F8FC"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Beeland Plus cần truy cập ảnh để bạn chọn ảnh giấy tờ nộp hồ sơ nhà ở xã hội.",
          "cameraPermission": "Beeland Plus cần dùng camera để bạn chụp giấy tờ nộp hồ sơ nhà ở xã hội.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A74B8",
          "defaultChannel": "chat"
        }
      ],
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "683ee023-0d13-43e5-b566-65bd437ba581"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/683ee023-0d13-43e5-b566-65bd437ba581"
    }
  }
}
